# Public base URL of this app (no trailing slash)
BASE_URL=http://localhost:3000
PORT=3000

# Script timezone (Apps Script Session.getScriptTimeZone)
SCRIPT_TIMEZONE=Europe/Berlin

# Seeded Main Admin (matches CONFIG.ADMIN_OWNER_EMAIL / ADMIN_DEFAULT_PASSWORD in Code.gs)
ADMIN_OWNER_EMAIL=altersstudie@lin-magdeburg.de
ADMIN_DEFAULT_PASSWORD=123456

# --- SMTP (required) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Experiment Scheduler <your@email.com>

# --- Google Calendar API (required for invite/event behavior) ---
# Use a service account JSON key with Calendar access, and share both calendars
# with that service account (Make changes to events).
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
# On Vercel, prefer pasting the full JSON as a single-line env var instead of a file:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Impersonate this Google user for the "default" (owner) calendar, if using domain-wide delegation.
# Leave blank to use the service account's own calendar.
GOOGLE_CALENDAR_IMPERSONATE=
# Default calendar ID (usually the owner's email). Falls back to "primary".
GOOGLE_DEFAULT_CALENDAR_ID=primary
# Participant bookings calendar ID (must match CONFIG.PARTICIPANT_CALENDAR_EMAIL intent)
GOOGLE_PARTICIPANT_CALENDAR_ID=
# Optional: protect /api/cron/reminders on Vercel
# CRON_SECRET=some-long-secret

# SQLite database path
DATABASE_PATH=./data/scheduler.sqlite
